rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isApplicationOwner() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isApplicationOwner == true;
    }

    function tripDoc(tripId) {
      return firestore.get(/databases/(default)/documents/trips/$(tripId));
    }

    function tripExists(tripId) {
      return firestore.exists(/databases/(default)/documents/trips/$(tripId));
    }

    function isTripMember(tripId) {
      return isApplicationOwner()
        || (
          signedIn()
          && tripExists(tripId)
          && tripDoc(tripId).data.keys().hasAll(['memberUserIds'])
          && tripDoc(tripId).data.memberUserIds is list
          && request.auth.uid in tripDoc(tripId).data.memberUserIds
        );
    }

    function isTripOwner(tripId) {
      return signedIn()
        && tripExists(tripId)
        && tripDoc(tripId).data.ownerId == request.auth.uid;
    }

    function isValidChatImageUpload(tripId, ownerId, fileName) {
      return isTripMember(tripId)
        && ownerId == request.auth.uid
        && request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && fileName.matches('[A-Za-z0-9._-]+')
        && request.resource.metadata.authorId == request.auth.uid;
    }

    function isValidBannerFileName(fileName) {
      return fileName.matches('banner_[A-Za-z0-9._-]+');
    }

    // Legacy flat path — kept readable for existing messages.
    // Delete allowed once authorId metadata has been backfilled by the migration script.
    match /trips/{tripId}/messages/{fileName} {
      allow read: if isTripMember(tripId);
      allow delete: if isTripMember(tripId)
        && resource.metadata.keys().hasAny(['authorId'])
        && resource.metadata['authorId'] == request.auth.uid;
    }

    // Chat image attachments: trips/{tripId}/messages/{authorUid}/<messageId>.<ext>
    match /trips/{tripId}/messages/{ownerId}/{fileName} {
      allow read: if isTripMember(tripId);
      allow create, update: if isValidChatImageUpload(tripId, ownerId, fileName);
      allow delete: if isTripMember(tripId)
        && ownerId == request.auth.uid;
    }

    // Banner assets are stored under:
    // trips/{tripId}/banner_<timestamp>.<ext>
    match /trips/{tripId}/{fileName} {
      allow write: if isTripOwner(tripId)
        && isValidBannerFileName(fileName);
    }

    match /trips/{tripId}/{allPaths=**} {
      allow read: if isTripMember(tripId);
      allow write: if false;
    }

    // Profile assets are stored under:
    // users/{uid}/profile_<timestamp>.<ext>
    // Single path segment on purpose: a recursive match here would also
    // grant unrestricted writes inside users/{uid}/wallet/ below.
    match /users/{uid}/{fileName} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Personal trip documents ("Mes documents"), owner only:
    // users/{uid}/wallet/{tripId}/<documentId>.<ext>
    // Kept out of trips/{tripId}/ on purpose: the catch-all rule there lets
    // every trip member read everything under it.
    match /users/{uid}/wallet/{tripId}/{fileName} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      // resource == null: a stored file is never replaced (see update).
      allow create: if signedIn()
        && request.auth.uid == uid
        && resource == null
        && isTripMember(tripId)
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/(jpeg|png|webp|heic|heif)')
        && fileName.matches('[A-Za-z0-9._-]+');
      allow update: if false;
    }

    // Personal photos attached to activities, owner only (same retention as
    // the personal documents above):
    // users/{uid}/activityPhotos/{tripId}/<photoId>.jpg and <photoId>_thumb.jpg
    // Removed server-side when their record is deleted (author, trip admin,
    // activity deletion, cleanups).
    match /users/{uid}/activityPhotos/{tripId}/{fileName} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && resource == null
        && isTripMember(tripId)
        && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg'
        && fileName.matches('[A-Za-z0-9]+(_thumb)?[.]jpg');
      allow update: if false;
    }

    // Trip export / import files, owner only:
    // users/{uid}/tripTransfers/<file>.json
    // Exports are written by the exportTrip function, imports uploaded here
    // for importTrip; each is deleted once used (left-overs after a day).
    match /users/{uid}/tripTransfers/{fileName} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.contentType == 'application/json'
        && fileName.matches('[A-Za-z0-9._-]+');
      allow update: if false;
    }

    // Self-managed preview release metadata + APK (see RELEASE.md / preview publishing).
    match /versions/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
